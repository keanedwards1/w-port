{
  "name": "kean-edwards-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5280",
    "build": "tsc --noEmit && vite build --outDir dist/client --emptyOutDir && vite build --ssr src/entry-server.tsx --outDir dist/server && tsx scripts/prerender.ts",
    "preview": "vite preview --outDir dist/client --port 5281",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "images": "tsx scripts/process-images.ts",
    "qa": "tsx scripts/qa.ts",
    "serve": "tsx scripts/serve.ts 5290",
    "qa:flows": "tsx scripts/qa-flows.ts",
    "capture": "tsx scripts/capture-sites.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright-core": "^1.65.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
