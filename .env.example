# Your real address, with no trailing slash. Sets canonical URLs, the sitemap, and social cards.
VITE_SITE_URL=https://keanedwards.com

# Optional. Adds Google PageSpeed scores to the Site Check.
# Create a free key at https://developers.google.com/speed/docs/insights/v5/get-started
# then restrict it to your domain in Google Cloud. It is safe in the browser once restricted.
VITE_PSI_API_KEY=
